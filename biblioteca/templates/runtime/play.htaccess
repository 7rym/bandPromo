RewriteEngine On
RewriteBase /play/

RewriteRule ^$ index.php [L,QSA]
RewriteRule ^([a-z][a-z0-9-]*)/([a-z][a-z0-9-]*)/([a-z0-9-]+)/?$ index.php?campaign=$1&playlist=$2&track=$3 [L,QSA]
RewriteRule ^([a-z][a-z0-9-]*)/([a-z][a-z0-9-]*)/?$ index.php?campaign=$1&playlist=$2 [L,QSA]
RewriteRule ^([a-z][a-z0-9-]*)/?$ index.php?campaign=$1 [L,QSA]
