# System files
.DS_Store
Thumbs.db

# Runtime preservation checklist for future ZIP installs/updates:
# - Keep operator-owned runtime state out of git so package installs/updates never overwrite it.
# - The main preserved runtime roots are /data, /log, /backups, and /media.
# - Local site config and environment files must also stay outside git.
# - Demo/starter media is never repo-owned. It arrives via the published default-theme /
#   Demo Release packages during setup, and lives only under ignored /media on the host.
# - Apache/PHP protection stubs are generated from biblioteca/templates/runtime/ by setup
#   (and packaging), not tracked at install paths.

# Google Drive sync artifacts (Windows + Google Drive File Sync creates these everywhere)
# These MUST be ignored or they corrupt .git/refs/ when committed
desktop.ini
Desktop.ini
**/desktop.ini
**/Desktop.ini
.sync
.sync/**
~*.tmp
~*.lock
*~sync*
.sync-conflict-*
*/.sync
*/.sync/**

# IDE / local editor preferences (not product)
.vscode/
.idea/
.editorconfig
*.swp
*.swo
*~

# Local scanner/quarantine artifacts
_avg_/
**/_avg_/

# Build & Dependencies
__pycache__/
*.pyc
node_modules/
.env
.env.*
!.env.example

# Host-local Python site-packages created by build.py (wheels live in vendor-wheels/)
scripts/vendor/

# Local dev one-shot helpers (operator machine only)
scripts/run-local-cleanup.php

# Sensitive/local runtime config
FTP_PASS
credentials.txt
web-config.json

# Legacy local paths from older versions
biblioteca/bio.php
biblioteca/gallery.json

# Build artifacts (generated from web-config.json)
site.webmanifest

# Runtime folders (operator/server-managed; always preserve on install/update)
data/
log/
backups/

# Entire media root is runtime-only (operator uploads, generated tiers, and setup-seeded demo).
media/

# Host Apache/PHP stubs — generated from biblioteca/templates/runtime/
/.htaccess
/.user.ini
/play/.htaccess

# Defense in depth: media binaries outside /media must not enter git either
*.flac
*.mp3
*.wav
*.mp4
*.avi

# Build artifacts
*.zip
!biblioteca/templates/icons/bP-icons.zip
*.tar.gz
dist/
build/
.bandpromo-theme-package/
.bandpromo-demo-release-package/

# Keep track of what should be excluded
# but add exceptions for important config
!biblioteca/quizbase-*.json

# Generated build artifacts
play/playlist.json
play/playlist-validation.json
