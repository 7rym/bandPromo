# System files
.DS_Store
Thumbs.db

# Runtime preservation checklist for future ZIP installs/updates:
# - Keep operator-owned runtime state out of git so package installs/updates never overwrite it.
# - The main preserved runtime roots are /data and /media.
# - Local site config and environment files must also stay outside git.
# - Some bundled demo media under /media remains intentionally tracked as install seed content,
#   so the patterns below mix broad ignores with explicit keep-rules for shipped placeholders.

# Google Drive sync artifacts (Windows + Google Drive File Sync creates these everywhere)
# These MUST be ignored or they corrupt .git/refs/ when committed
desktop.ini
Desktop.ini
**/desktop.ini
**/Desktop.ini
.sync
.sync/**
~*.tmp
~*.lock
*~sync*
.sync-conflict-*
*/.sync
*/.sync/**

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Local scanner/quarantine artifacts
_avg_/
**/_avg_/

# Build & Dependencies
__pycache__/
*.pyc
node_modules/
.env
.env.*
!.env.example

# Sensitive/local runtime config
FTP_PASS
credentials.txt
web-config.json

# User-managed content (stored in data/ at runtime, never overwritten by git pull or ZIP update)
data/bio.html
data/gallery.json
data/faq.html
# Legacy local paths from older versions
biblioteca/bio.php
biblioteca/gallery.json

# Build artifacts (generated from web-config.json)
site.webmanifest

# Data folders (runtime/server-managed, always preserve on install/update)
data/*
log/
# But track the .htaccess that protects the data folder
!data/.htaccess

# Media files (runtime/operator-managed, always preserve on install/update unless explicitly
# shipped as bundled demo assets kept by the allow-rules below)
*.flac
*.mp3
*.wav
*.mp4
*.avi

# Large image files (keep only source PNGs)
media/**/*.jpg
media/**/*.jpeg

# Cover art extracted from audio files (generated by makePlaylists.py — not for repo)
media/img/original/*.png
media/img/original/*.jpg

# Build artifacts
*.zip
*.tar.gz
dist/
build/

# Ignore all user icons except the default zip
media/icons/*
!media/icons/bP-icons.zip

# Keep track of what should be excluded
# but add exceptions for important config
!biblioteca/quizbase-*.json
# bandPromo_* files are generic/placeholder assets bundled with the project
# and should always be tracked regardless of extension or location under media/
!media/audio/original/
!media/photo/original/
!media/video/original/
media/special/*
!media/**/bandPromo_*
# Special media dir itself must be tracked for the above rule to work
!media/special/

# Optimal/processed outputs are generated locally — never commit them
media/**/optimal/

# Master working copies are local runtime artifacts until the storage model is finalized
media/**/master/

# Dummy/demo cover art extracted locally from bundled audio placeholders
media/img/original/bandPromo_the_*.png

# Generated build artifacts
play/playlist.json
play/playlist-validation.json

# Generated social share derivatives (created by build)
media/special/*_facebook.jpg
media/special/*_twitter.jpg
