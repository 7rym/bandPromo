{
  "version": 1,
  "profiles": {
    "full": [
      "catalog",
      "deliverables-media",
      "sfx-delivery",
      "video-delivery",
      "playlist-artifacts",
      "visual-delivery-catchup",
      "social-assets",
      "pwa-manifest"
    ],
    "deliverables-only": [
      "catalog",
      "deliverables-media",
      "sfx-delivery",
      "video-delivery",
      "playlist-artifacts",
      "visual-delivery-catchup"
    ],
    "artifacts-only": [
      "playlist-artifacts",
      "visual-delivery-catchup",
      "social-assets",
      "pwa-manifest"
    ]
  },
  "stages": [
    {
      "id": "catalog",
      "label": "Prepare asset catalog and audio masters",
      "group": "catalog",
      "script": "buildCatalog.py",
      "skippable": true
    },
    {
      "id": "deliverables-media",
      "label": "Optimize media (audio + image + photo)",
      "group": "deliverables",
      "script": "optimizeMedia.py",
      "requires_ffmpeg": true,
      "env": {
        "BANDPROMO_OPTIMIZE_MODE": "full"
      },
      "skippable": true
    },
    {
      "id": "sfx-delivery",
      "label": "Build sound-effect delivery MP3s",
      "group": "deliverables",
      "script": "buildSfxDelivery.py",
      "requires_ffmpeg": true,
      "skippable": true
    },
    {
      "id": "video-delivery",
      "label": "Build video delivery assets",
      "group": "deliverables",
      "script": "optimizeVideo.py",
      "requires_ffmpeg": true,
      "skippable": true
    },
    {
      "id": "playlist-artifacts",
      "label": "Export playlist validation report and publish player payloads",
      "group": "artifacts",
      "script": "makePlaylists.py",
      "skippable": true
    },
    {
      "id": "visual-delivery-catchup",
      "label": "Build Visual delivery for covers extracted during playlist stage",
      "group": "artifacts",
      "script": "optimizeMedia.py",
      "env": {
        "BANDPROMO_OPTIMIZE_MODE": "image-only"
      },
      "skippable": true
    },
    {
      "id": "social-assets",
      "label": "Generate social media assets",
      "group": "artifacts",
      "script": "makeSocial.py",
      "skippable": true
    },
    {
      "id": "pwa-manifest",
      "label": "Generate PWA manifest",
      "group": "artifacts",
      "script": "makePWA.py",
      "skippable": true
    }
  ]
}
